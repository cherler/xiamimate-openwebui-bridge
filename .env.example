## Phase 5 shadow validation defaults
OPEN_WEBUI_NGINX_IMAGE=nginx:latest
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
PIPELINES_IMAGE=ghcr.io/open-webui/pipelines:main

OPEN_WEBUI_PORT=13002
PIPELINES_PORT=19099

OPEN_WEBUI_SECRET_KEY=replace-with-a-long-random-string
PIPELINES_API_KEY=replace-with-another-random-string

XIAMIMATE_MODEL_PREFIX=xiamimate

CHAT_BACKEND_BASE_URL=http://host.docker.internal:8200
CHAT_BACKEND_TIMEOUT=180
CHAT_BACKEND_SERVICE_SECRET=replace-with-a-long-random-string
CHAT_BACKEND_TRUSTED_ADMIN_SERVICE_NAME=openwebui-bridge-admin
CHAT_BACKEND_SERVICE_NAME=open-webui-pipeline
DIFY_CHATBOT_BASE_URL=http://host.docker.internal:80

DIFY_REQUEST_TIMEOUT=600

AGENT_OPENAI_MODEL=deepseek-v4-pro
AGENT_OPENAI_APIYI_MODEL=gpt-5.5
AGENT_ANTHROPIC_MODEL=MiniMax-M2.7-highspeed
AGENT_MODEL_DEFAULT_PROFILE=deepseek
AGENT_MODEL_PROFILES=deepseek,minimax,apiyi
AGENT_MODEL_DEEPSEEK_LABEL="DeepSeek V4 Pro"
AGENT_MODEL_APIYI_LABEL="GPT-5.5"
AGENT_MODEL_MINIMAX_LABEL="MiniMax M2.7"

# Optional: lightweight planner model. If empty, planner reuses the agent model.
# Use a non-reasoning model (e.g. deepseek-chat or MiniMax-M2.7-highspeed) to keep
# planner latency low and reserve the reasoner only for final synthesis.
AGENT_PLANNER_MODEL=
# Heartbeat interval (seconds) for "正在规划执行路径" while planner LLM is running.
AGENT_PLANNER_HEARTBEAT_SECONDS=5
# Max number of past tool observations injected into the planner payload.
# The newest observation is kept in full; older ones are compressed into a
# deterministic head+tail digest so planner sees structure but not the full payload.
AGENT_PLANNER_OBSERVATION_LIMIT=4
# Optional: bypass chat-backend for the planner LLM call and hit an OpenAI-
# compatible /chat/completions endpoint directly. Useful when chat-backend
# hard-binds a single model name per provider and you want planner to use a
# different cheaper model. Both BASE_URL and API_KEY must be set; otherwise
# planner falls back to the chat-backend proxy path.
AGENT_PLANNER_BASE_URL=
AGENT_PLANNER_API_KEY=
# Optional: lightweight LLM used to translate opportunity titles (Amazon leaf
# categories) into Chinese before rendering bilingual cards. Empty disables the
# translation step (titles fall back to English-only). Reuse the planner model
# or set a separate fast model.
AGENT_TITLE_TRANSLATOR_MODEL=
AGENT_TITLE_TRANSLATION_TIMEOUT=20
# Optional: direct OpenAI-compatible endpoint for the title translator, same
# semantics as AGENT_PLANNER_BASE_URL / _API_KEY above.
AGENT_TITLE_TRANSLATOR_BASE_URL=
AGENT_TITLE_TRANSLATOR_API_KEY=
# When true (default), opportunity_discovery's final answer skips the synthesis
# LLM and uses the deterministic renderer output directly (bilingual cards +
# ranking table). Only triggered when answer_contract requires opportunity
# cards AND the last tool call returned a non-empty structured payload.
# Set to false to force every answer through the synthesis LLM.
AGENT_OPPORTUNITY_BYPASS_SYNTHESIS=true
# JSONL trace sink for agent harness (planner/tool/grader events). Empty disables.
AGENT_TRACE_SINK_PATH=/app/logs/agent-trace.jsonl